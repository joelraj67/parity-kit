{
  "name": "parity-kit",
  "version": "1.0.0",
  "description": "AI-native visual, layout, animation & SEO parity scanner for web migrations. Pixel-perfect regression testing with Playwright.",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "src/types.d.ts",
  "type": "module",
  "bin": {
    "parity-kit": "./bin/cli.js",
    "parity": "./bin/cli.js",
    "web-parity-kit": "./bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "c8 --reporter=text --reporter=lcov --all --src src --check-coverage --lines 50 --branches 60 --functions 40 node --test test/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\" \"bin/**/*.js\" \"test/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"bin/**/*.js\" \"test/**/*.js\"",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "prepare": "",
    "postinstall": "npx playwright install chromium"
  },
  "keywords": [
    "visual-regression",
    "parity-testing",
    "web-migration",
    "pixel-perfect",
    "playwright",
    "seo-audit",
    "diff-engine",
    "ai-testing",
    "nextjs-migration",
    "astro-migration",
    "remix-migration",
    "parity-kit",
    "migration-testing",
    "visual-testing"
  ],
  "author": "Joel Raj Bathula <https://github.com/joelraj67>",
  "repository": {
    "type": "git",
    "url": "https://github.com/joelraj67/parity-kit.git"
  },
  "homepage": "https://github.com/joelraj67/parity-kit#readme",
  "bugs": {
    "url": "https://github.com/joelraj67/parity-kit/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "pixelmatch": "^7.2.0",
    "playwright": "1.62.1",
    "pngjs": "^7.0.0",
    "zod": "4.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/joelraj67"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "c8": "12.0.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
